{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"], "skipLibCheck": true, "noEmit": true, "isolatedModules": true,
    "resolveJsonModule": true, "noImplicitAny": false
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
